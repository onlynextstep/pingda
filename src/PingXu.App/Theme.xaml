<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <SolidColorBrush x:Key="Bg" Color="#151616"/><SolidColorBrush x:Key="Panel" Color="#1A1B1B"/><SolidColorBrush x:Key="Ink" Color="#F0F1EB"/><SolidColorBrush x:Key="Muted" Color="#A7AC9F"/><SolidColorBrush x:Key="Line" Color="#363838"/><SolidColorBrush x:Key="Acid" Color="#DCFF42"/>
