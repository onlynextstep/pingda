<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <StartupObject>PingXu.Drag.Tests.DragTestRunner</StartupObject>
  </PropertyGroup>
  <ItemGroup>
    <!-- Only the mathematical/drawing/event modules: no App startup, file store or Windows backend. -->
    <Compile Include="../../src/PingXu.Core/Contracts.cs" Link="Production/Contracts.cs" />
    <Compile Include="../../src/PingXu.Core/LayoutDrag.cs" Link="Production/LayoutDrag.cs" />
    <Compile Include="../../src/PingXu.App/StudioDrawing.cs" Link="Production/StudioDrawing.cs" />
    <Compile Include="../../src/PingXu.App/NumberArtwork.cs" Link="Production/NumberArtwork.cs" />
    <EmbeddedResource Include="../../src/PingXu.App/Assets/Numbers/*.png" LogicalName="PingXu.Numbers.%(Filename)%(Extension)" />
    <Compile Include="../../src/PingXu.App/StudioDragController.cs" Link="Production/StudioDragController.cs" />
  </ItemGroup>
</Project>
